<Window x:Class="NightLightControl.UI.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:NightLightControl.UI" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Night Light Control" Width="1280" Height="850" MinWidth="1080" MinHeight="740"
 WindowStyle="None" ResizeMode="CanResize" Background="#020203" Foreground="#F4F4F7" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Border BorderBrush="#77777D" BorderThickness="1"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition/><RowDefinition Height="36"/></Grid.RowDefinitions>
  <Border BorderBrush="#626268" BorderThickness="0,0,0,1"><Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <local:HeaderPattern Grid.ColumnSpan="3" Width="360" HorizontalAlignment="Right" ClipToBounds="True" Margin="0,0,155,0" IsHitTestVisible="False"/>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
    <Path Data="M 26,2 A 16,16 0 1 0 29,29 A 14,14 0 0 1 26,2 Z" Fill="White" Width="34" Height="34" Stretch="Uniform" Margin="0,0,13,0"/>
    <TextBlock Text="Night Light Control" FontSize="21" FontWeight="Bold" VerticalAlignment="Center"/>
    <Border Width="1" Height="23" Background="#6E6E75" Margin="20,0"/>
   </StackPanel>
   <TextBlock Grid.Column="1" Text="Luz nocturna de Windows" Foreground="#CECED4" VerticalAlignment="Center" FontSize="14"/>
   <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="MinimizeClicked" ToolTip="Minimizar" AutomationProperties.Name="Minimizar"/>
    <Button Style="{StaticResource WindowButton}" Content="&#xE922;" Click="MaximizeClicked" ToolTip="Maximizar / restaurar" AutomationProperties.Name="Maximizar o restaurar"/>
    <Button Style="{StaticResource WindowButton}" Content="&#xE8BB;" Click="CloseClicked" ToolTip="Cerrar a la bandeja" AutomationProperties.Name="Cerrar a la bandeja"/>
   </StackPanel>
  </Grid></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="194"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border BorderBrush="#626268" BorderThickness="0,0,1,0"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,20,0,0">
     <RadioButton x:Name="CurveNav" Style="{StaticResource NavigationButton}" GroupName="Navigation" IsChecked="True" Tag="Curve" Checked="Navigate"><StackPanel Orientation="Horizontal"><Path Data="M 0,19 L 6,19 10,10 17,10 23,1" Stroke="White" StrokeThickness="2" Width="24" Height="22" Margin="0,0,12,0"/><TextBlock Text="Curva diaria" VerticalAlignment="Center"/></StackPanel></RadioButton>
     <RadioButton x:Name="ProfilesNav" Style="{StaticResource NavigationButton}" GroupName="Navigation" Tag="Profiles" Checked="Navigate"><StackPanel Orientation="Horizontal"><Path Data="M 2,2 L 22,2 22,22 2,22 Z M 6,7 L 18,7 M 6,12 L 14,12" Stroke="White" StrokeThickness="1.5" Width="24" Height="24" Margin="0,0,12,0"/><TextBlock Text="Perfiles" VerticalAlignment="Center"/></StackPanel></RadioButton>
     <RadioButton x:Name="PreferencesNav" Style="{StaticResource NavigationButton}" GroupName="Navigation" Tag="Preferences" Checked="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="23" Width="24" Margin="0,0,12,0"/><TextBlock Text="Preferencias" VerticalAlignment="Center"/></StackPanel></RadioButton>
     <RadioButton x:Name="UpdatesNav" Style="{StaticResource NavigationButton}" GroupName="Navigation" Tag="Updates" Checked="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="22" Width="24" Margin="0,0,12,0"/><TextBlock x:Name="UpdatesNavText" Text="Actualizaciones" VerticalAlignment="Center" FontSize="12"/></StackPanel></RadioButton>
    </StackPanel>
    <StackPanel Grid.Row="2" Margin="18,0,18,18">
     <TextBlock Text="MOTOR DE WINDOWS" FontSize="10" Foreground="#97979F" Margin="0,0,0,7"/>
     <TextBlock Text="Control nativo" FontSize="14" FontWeight="SemiBold"/>
     <TextBlock Text="Tu curva, durante todo el día." Style="{StaticResource Muted}" FontSize="11" Margin="0,7,0,15"/>
     <Button Content="Luz nocturna ↗" Click="OpenWindows" FontSize="11" Margin="0" Padding="8,9"/>
     <local:HeaderPattern Height="45" Margin="-17,25,-17,-18" ClipToBounds="True" IsHitTestVisible="False"/>
    </StackPanel>
   </Grid></Border>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,19,24,22">
     <Grid Margin="4,0,0,17"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock x:Name="PageTitle" Text="Curva diaria" FontSize="28" FontWeight="Bold"/><TextBlock x:Name="PageSubtitle" Text="Elige la calidez de cada momento del día." Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
      <Button Grid.Column="1" x:Name="EnableButton" Content="Activar control" Click="ToggleEnabled" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Margin="12,0,0,0"/>
     </Grid>
     <local:AngularPanel Padding="24,18" Margin="0,0,0,18">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="CALIDEZ APLICADA" Foreground="#B4B4BD" FontSize="10" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal"><TextBlock x:Name="IntensityText" Text="—" FontSize="44" FontWeight="SemiBold"/><TextBlock Text="%" FontSize="21" Margin="5,19,0,0" Foreground="#B4B4BD"/></StackPanel>
        <TextBlock x:Name="KelvinText" Text="Control desactivado" Style="{StaticResource Muted}" FontSize="11"/>
       </StackPanel>
       <Border Grid.Column="1" Background="#4A4A50" Margin="0,4"/>
       <StackPanel Grid.Column="2" Margin="26,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="StatusText" Text="Comprobando motor nativo…" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="BackendText" Text="Windows" Style="{StaticResource Muted}" Margin="0,8,0,0" FontSize="12"/>
        <TextBlock x:Name="DisplayText" Style="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
       </StackPanel>
      </Grid>
     </local:AngularPanel>
     <Grid x:Name="CurveView"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="224"/></Grid.ColumnDefinitions>
      <local:AngularPanel Padding="20,20,18,17"><StackPanel>
       <TextBlock Text="Curva de intensidad" Style="{StaticResource SectionTitle}"/>
       <TextBlock x:Name="CurveProfileText" Text="Perfil · Mi curva" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,0,4"/>
       <local:CurveEditor x:Name="Editor" Height="302"/>
       <WrapPanel Margin="0,12,0,0" VerticalAlignment="Center">
        <TextBlock Text="Hora" VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#B4B4BD"/><TextBox x:Name="PointTime" Width="71" Margin="0,0,12,8" ToolTip="Hora del punto (HH:mm)" KeyDown="PointKeyDown" LostKeyboardFocus="PointLostFocus"/>
        <TextBlock Text="%" VerticalAlignment="Center" Margin="0,0,8,8" Foreground="#B4B4BD"/><TextBox x:Name="PointStrength" Width="52" Margin="0,0,12,8" ToolTip="Intensidad del punto (0–100 %)" KeyDown="PointKeyDown" LostKeyboardFocus="PointLostFocus"/>
        <Button Content="+ Punto" Click="AddPoint" Padding="11,8" Margin="0,0,8,8"/><Button Content="−" ToolTip="Eliminar punto seleccionado" Click="DeletePoint" Padding="12,8" Margin="0,0,8,8"/>
        <Button x:Name="SaveCurveButton" Content="Guardar curva" Click="SaveCurveClicked" Style="{StaticResource PrimaryButton}" Padding="12,8" Margin="0,0,0,8"/>
       </WrapPanel>
       <TextBlock Text="Arrastra los puntos · Doble clic para añadir · Supr para eliminar" Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
      </StackPanel></local:AngularPanel>
      <local:AngularPanel Grid.Column="2" Padding="22,22,20,20"><StackPanel>
       <TextBlock Text="Control" Style="{StaticResource SectionTitle}" Margin="7,0,0,15"/>
       <RadioButton x:Name="AutoMode" GroupName="Mode" Content="Seguir mi curva" Checked="ModeChanged"/>
       <RadioButton x:Name="ManualMode" GroupName="Mode" Content="Control manual" Checked="ModeChanged"/>
       <Slider x:Name="ManualSlider" ValueChanged="ManualChanged" Margin="0,14,0,0"/>
       <TextBlock x:Name="ManualLabel" Text="40 % manual" Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,23"/>
       <Button x:Name="PauseButton" Content="Pausar 1 hora" Click="PauseClicked" Margin="0,0,0,22"/>
       <Border Height="1" Background="#45454B" Margin="0,0,0,18"/>
       <TextBlock Text="0 % · Luz neutra" FontSize="12"/>
       <TextBlock Text="100 % · Máxima calidez" FontSize="12" Margin="0,7,0,13"/>
       <TextBlock Text="Los puntos se unen con transiciones suaves. La curva se repite cada día." Style="{StaticResource Muted}" FontSize="11" LineHeight="17"/>
      </StackPanel></local:AngularPanel>
     </Grid>
     <StackPanel x:Name="ProfilesView" Visibility="Collapsed">
      <local:AngularPanel><StackPanel>
       <TextBlock Text="Mis perfiles" Style="{StaticResource SectionTitle}"/>
       <TextBlock Text="Cada perfil conserva sus propios horarios e intensidades." Style="{StaticResource Muted}" Margin="10,0,0,19"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <ComboBox x:Name="ProfileBox" DisplayMemberPath="Name" SelectionChanged="ProfileChanged" Margin="0,0,17,0"/>
        <WrapPanel Grid.Column="1"><Button Content="Duplicar" Click="DuplicateProfile"/><Button Content="Renombrar" Click="RenameProfile"/><Button Content="Eliminar" Click="DeleteProfile"/></WrapPanel>
       </Grid>
       <local:CurveEditor x:Name="ProfilePreview" Height="230" IsHitTestVisible="False" Focusable="False" Margin="0,16,0,0"/>
       <Button Content="Editar esta curva →" Click="EditCurrentCurve" HorizontalAlignment="Left" Margin="0,12,0,0"/>
      </StackPanel></local:AngularPanel>
     </StackPanel>
     <StackPanel x:Name="PreferencesView" Visibility="Collapsed">
      <local:AngularPanel Margin="0,0,0,17"><StackPanel>
       <TextBlock Text="Comportamiento" Style="{StaticResource SectionTitle}"/>
       <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel><CheckBox x:Name="StartupCheck" Content="Iniciar con Windows, en la bandeja" Click="StartupChanged"/><CheckBox x:Name="FullscreenCheck" Content="Pausar en pantalla completa" Click="PreferencesChanged"/><CheckBox x:Name="RecoveryCheck" Content="Restaurar color tras un cierre inesperado" Click="PreferencesChanged"/></StackPanel>
        <StackPanel Grid.Column="2" Margin="0,8,0,0"><TextBlock x:Name="TransitionLabel" Text="Transición de 0 a 100 %: 10 s"/><Slider x:Name="TransitionSlider" Minimum="1" Maximum="120" ValueChanged="PreferencesChanged" Margin="0,12,0,0"/><TextBlock Text="Suaviza la activación, desactivación y los cambios de modo o perfil." Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
       </Grid>
      </StackPanel></local:AngularPanel>
      <local:AngularPanel Margin="0,0,0,17"><StackPanel>
       <TextBlock Text="Exclusiones por aplicación" Style="{StaticResource SectionTitle}"/>
       <TextBlock Text="Pausar cuando una de estas aplicaciones esté en primer plano." Style="{StaticResource Muted}" Margin="10,0,0,14"/>
       <TextBox x:Name="ExclusionsBox" LostKeyboardFocus="ExclusionsChanged" ToolTip="Nombres separados por comas, por ejemplo Photoshop.exe, juego.exe"/>
       <TextBlock Text="Escribe nombres .exe separados por comas. Ejemplo: Photoshop.exe, juego.exe" Style="{StaticResource Muted}" FontSize="11" Margin="0,9,0,0"/>
      </StackPanel></local:AngularPanel>
      <local:AngularPanel><StackPanel><TextBlock Text="Color y restauración" Style="{StaticResource SectionTitle}"/><TextBlock Text="Al desactivar el control se vuelve gradualmente al color de Windows. Al pausar o salir, se restaura de inmediato. Cerrar la ventana mantiene el programa en la bandeja. La protección usa un auxiliar independiente para intentar recuperar el color tras un cierre inesperado." Style="{StaticResource Muted}" Margin="10,2,0,14" LineHeight="20"/><Button Content="Abrir Luz nocturna de Windows ↗" Click="OpenWindows" HorizontalAlignment="Left"/></StackPanel></local:AngularPanel>
     </StackPanel>
     <StackPanel x:Name="UpdatesView" Visibility="Collapsed">
      <local:AngularPanel Margin="0,0,0,17"><StackPanel>
       <TextBlock Text="Versiones del programa" Style="{StaticResource SectionTitle}"/>
       <TextBlock x:Name="InstalledVersionText" Text="Versión instalada" FontSize="16" Margin="10,12,0,10"/>
       <TextBlock x:Name="UpdateStatusText" Text="Busca las versiones publicadas en GitHub." Style="{StaticResource Muted}" Margin="10,0,0,6" LineHeight="20"/>
       <TextBlock x:Name="LatestVersionText" Text="" Style="{StaticResource Muted}" Margin="10,0,0,18"/>
       <WrapPanel Margin="0,0,0,14"><Button x:Name="CheckUpdatesButton" Content="Buscar actualizaciones" Click="CheckUpdatesClicked"/><Button x:Name="InstallUpdateButton" Content="Descargar e instalar" Click="InstallUpdateClicked" IsEnabled="False" Style="{StaticResource PrimaryButton}"/></WrapPanel>
       <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Height="6" Foreground="White" Background="#28282D" Visibility="Collapsed" Margin="0,0,0,14"/>
       <CheckBox x:Name="UpdateStartupCheck" Content="Buscar actualizaciones al iniciar el programa" Click="UpdatePreferencesChanged"/>
      </StackPanel></local:AngularPanel>
      <local:AngularPanel><StackPanel>
       <TextBlock Text="Tus perfiles se conservan" Style="{StaticResource SectionTitle}"/>
       <TextBlock Text="La instalación se realiza cuando pulsas Descargar e instalar. Se comprueba la descarga y se conserva una copia de la versión anterior. El programa se cerrará y volverá a abrirse al terminar." Style="{StaticResource Muted}" Margin="10,2,0,18" LineHeight="21"/>
       <Button Content="Ver versiones en GitHub ↗" Click="OpenReleases" HorizontalAlignment="Left"/>
      </StackPanel></local:AngularPanel>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <Border Grid.Row="2" BorderBrush="#626268" BorderThickness="0,1,0,0"><Grid Margin="18,0,15,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="FooterVersionText" Text="●  Night Light Control" VerticalAlignment="Center" FontSize="11"/>
   <TextBlock Grid.Column="1" x:Name="FooterProfileText" Text="Mi curva" VerticalAlignment="Center" Foreground="#C0C0C8" FontSize="11" Margin="18,0,0,0"/>
   <TextBlock Grid.Column="2" x:Name="SaveText" Text="Cambios guardados" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#C0C0C8" FontSize="11" Margin="8,0,20,0"/>
   <Button Grid.Column="3" Content="Salir y restaurar" Click="ExitClicked" Padding="11,5" FontSize="11" Margin="0"/>
  </Grid></Border>
 </Grid></Border>
</Window>
